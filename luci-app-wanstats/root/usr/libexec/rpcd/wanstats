#!/bin/sh
# rpcd plugin: exposes the wanstats daily/monthly history to LuCI.
# Protocol: "list" prints method signatures, "call <method>" reads a
# JSON object on stdin and prints a JSON result on stdout.

data_dir() {
	local d=""
	if [ -n "$WANSTATS_DATA_DIR" ]; then
		d="$WANSTATS_DATA_DIR"
	elif command -v uci >/dev/null 2>&1; then
		d="$(uci -q get wanstats.settings.data_dir 2>/dev/null)"
	fi
	echo "${d:-/etc/wanstats}"
}

valid_lines() {
	# only well-formed rows ever reach the UI / JSON output
	awk -F, '/^[0-9]{4}-[0-9]{2}-[0-9]{2},[0-9]+,[0-9]+$/ { print $1","$2","$3 }' "$1" 2>/dev/null
}

get_history() {
	local dir daily dev updated
	dir="$(data_dir)"
	daily="$dir/daily.csv"
	dev=""; updated=0
	if [ -r "$dir/state" ]; then
		read -r dev _rx _tx updated < "$dir/state"
		case "$dev" in *[!A-Za-z0-9_.-]*|'') dev="" ;; esac
		case "$updated" in ''|*[!0-9]*) updated=0 ;; esac
	fi

	printf '{"device":"%s","updated":%s,"daily":[' "$dev" "$updated"
	if [ -r "$daily" ]; then
		valid_lines "$daily" | sort -r | awk -F, '
			BEGIN { n = 0 }
			{ printf "%s{\"date\":\"%s\",\"rx\":%s,\"tx\":%s}", (n++ ? "," : ""), $1, $2, $3 }
		'
	fi
	printf '],"monthly":['
	if [ -r "$daily" ]; then
		valid_lines "$daily" | awk -F, '
			{ m = substr($1, 1, 7); rx[m] += $2; tx[m] += $3 }
			END { for (k in rx) printf "%s,%s,%s\n", k, rx[k], tx[k] }
		' | sort -r | awk -F, '
			BEGIN { n = 0 }
			{ printf "%s{\"month\":\"%s\",\"rx\":%s,\"tx\":%s}", (n++ ? "," : ""), $1, $2, $3 }
		'
	fi
	printf ']}\n'
}

get_status() {
	local dir daily dev updated last_rx last_tx
	dir="$(data_dir)"
	daily="$dir/daily.csv"
	dev=""; updated=0; last_rx=0; last_tx=0
	if [ -r "$dir/state" ]; then
		read -r dev last_rx last_tx updated < "$dir/state"
		case "$dev" in *[!A-Za-z0-9_.-]*|'') dev="" ;; esac
		case "$updated" in ''|*[!0-9]*) updated=0 ;; esac
		case "$last_rx" in ''|*[!0-9]*) last_rx=0 ;; esac
		case "$last_tx" in ''|*[!0-9]*) last_tx=0 ;; esac
	fi
	local running=0
	pidof wanstatsd >/dev/null 2>&1 && running=1
	local days=0
	[ -r "$daily" ] && days="$(valid_lines "$daily" | wc -l | tr -d ' ')"
	printf '{"running":%s,"device":"%s","updated":%s,"counter_rx":%s,"counter_tx":%s,"days":%s}\n' \
		"$running" "$dev" "$updated" "$last_rx" "$last_tx" "${days:-0}"
}

get_options() {
	# logical interfaces (from ubus) + physical devices (from sysfs),
	# used by the settings page to build the interface selection list
	local sysfs dump i cnt name proto dev l3
	sysfs="${WANSTATS_SYSFS:-/sys/class/net}"
	printf '{"interfaces":['
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		dump="$(ubus call network.interface dump 2>/dev/null)"
		if [ -n "$dump" ]; then
			i=0; cnt=0
			while :; do
				name="$(printf '%s' "$dump" | jsonfilter -e "@.interface[$i].interface" 2>/dev/null)"
				[ -n "$name" ] || break
				proto="$(printf '%s' "$dump" | jsonfilter -e "@.interface[$i].protocol" 2>/dev/null)"
				dev="$(printf '%s' "$dump" | jsonfilter -e "@.interface[$i].device" 2>/dev/null)"
				l3="$(printf '%s' "$dump" | jsonfilter -e "@.interface[$i].l3_device" 2>/dev/null)"
				i=$((i+1))
				case "$name" in *[!A-Za-z0-9_.-]*) continue ;; esac
				case "$proto" in *[!A-Za-z0-9_.-]*) proto="" ;; esac
				case "$dev" in *[!A-Za-z0-9_.-]*) dev="" ;; esac
				case "$l3" in *[!A-Za-z0-9_.-]*) l3="" ;; esac
				[ "$cnt" -gt 0 ] && printf ','
				printf '{"name":"%s","proto":"%s","device":"%s","l3_device":"%s"}' "$name" "$proto" "$dev" "$l3"
				cnt=$((cnt+1))
			done
		fi
	fi
	printf '],"devices":['
	local n=0 d
	for d in "$sysfs"/*; do
		[ -d "$d" ] || continue
		d="${d##*/}"
		case "$d" in *[!A-Za-z0-9_.-]*|'') continue ;; esac
		[ "$n" -gt 0 ] && printf ','
		printf '"%s"' "$d"
		n=$((n+1))
	done
	printf ']}\n'
}

case "$1" in
	list)
		printf '{"get_history":{},"get_status":{},"get_options":{}}\n'
		;;
	call)
		# consume the JSON argument object
		read -r _input
		case "$2" in
			get_history) get_history ;;
			get_status) get_status ;;
			get_options) get_options ;;
			*) printf '{}\n' ;;
		esac
		;;
esac
