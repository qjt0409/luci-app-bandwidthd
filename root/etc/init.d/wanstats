#!/bin/sh /etc/rc.common
# WAN daily/monthly traffic statistics (Padavan rstats-style)
START=95
USE_PROCD=1

start_service() {
	local enabled
	enabled="$(uci -q get wanstats.settings.enabled 2>/dev/null)"
	[ "$enabled" = "0" ] && return 0

	procd_open_instance
	procd_set_param command /usr/sbin/wanstatsd
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "wanstats"
}

reload_service() {
	restart
}
